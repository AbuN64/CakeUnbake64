{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "unbake:result.unify",
  "type": "object",
  "required": [
    "complete",
    "baseline",
    "names",
    "clashing",
    "units",
    "unified",
    "unresolved",
    "seconds",
    "batches",
    "rounds",
    "verified",
    "rebuilt",
    "files",
    "objects",
    "held"
  ],
  "properties": {
    "complete": {
      "description": "False for the result of a run still deciding (or cut short): only the names decided so far; the next run resumes from it.",
      "type": "boolean"
    },
    "baseline": {
      "description": "Digest of the baseline objects and names the result was made from: a resume must match it.",
      "type": "string",
      "minLength": 1
    },
    "names": {
      "type": "integer",
      "minimum": 0
    },
    "clashing": {
      "type": "integer",
      "minimum": 0
    },
    "units": {
      "type": "integer",
      "minimum": 0
    },
    "unified": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "type",
          "why",
          "header",
          "units",
          "seconds"
        ],
        "properties": {
          "type": {
            "type": "string",
            "minLength": 1
          },
          "why": {
            "const": "definition"
          },
          "header": {
            "type": "string",
            "minLength": 1
          },
          "units": {
            "type": "integer",
            "minimum": 0
          },
          "seconds": {
            "type": "number",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    },
    "unresolved": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        },
        "minProperties": 1
      }
    },
    "seconds": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "batches": {
      "type": "integer",
      "minimum": 0
    },
    "rounds": {
      "type": "integer",
      "minimum": 0
    },
    "rebuilt": {
      "type": "integer",
      "minimum": 0
    },
    "verified": {
      "type": "integer",
      "minimum": 0
    },
    "files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "objects": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "error",
          "names"
        ],
        "properties": {
          "error": {
            "description": "First compiler diagnostics for this bad object, or the object-difference reason.",
            "type": "string",
            "minLength": 1
          },
          "names": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    },
    "held": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        },
        "minProperties": 1
      }
    }
  },
  "additionalProperties": false
}
