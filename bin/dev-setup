#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."
# unbake names abucache bare: setup installs the commit abucache has landed (bin/abucache-requirement), never a pin.
requirement=$(bin/abucache-requirement)
python3 -m venv --clear .venv
.venv/bin/pip install "$requirement"
.venv/bin/pip install -e '.[dev]'
sha256sum pyproject.toml > .venv/.pyproject.sha256  # bin/test sets up again when pyproject changes
