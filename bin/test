#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."
# venv records its absolute creation target; moved checkouts retain stale pip shebangs.
# Check before invoking any environment code, including dependency refreshes.
if [[ ! -x .venv/bin/python || ! -f .venv/pyvenv.cfg || ! -r .venv/pyvenv.cfg ]]; then
    echo "run bin/dev-setup first (missing or unreadable checkout environment)" >&2
    exit 1
fi
venv_command=$(sed -n 's/^command = //p' .venv/pyvenv.cfg) || {
    echo "run bin/dev-setup first (cannot read checkout environment)" >&2
    exit 1
}
# Python writes the target without quoting, including when the checkout contains spaces.
if [[ "$venv_command" != *" -m venv "* || "$venv_command" != *" $(pwd -P)/.venv" ]]; then
    echo "run bin/dev-setup first (environment was created for another checkout or has no command target)" >&2
    exit 1
fi
export PYTHONPATH=src
# --changed: only the tests of what this branch changed against gitea/main (its test files, the test_<module>.py of each
# changed module) plus the lint and cli suites, which read every module, contract and command table.
if [[ "${1:-}" == --changed ]]; then
    shift
    base=$(git merge-base HEAD gitea/main 2>/dev/null || git rev-list --max-parents=0 HEAD | tail -1)
    selected=(tests/test_lint.py tests/test_cli.py)
    while IFS= read -r file; do
        case "$file" in
            tests/test_*.py) [[ -f "$file" ]] && selected+=("$file") ;;
            src/unbake/*.py) test_file="tests/test_$(basename "${file%.py}").py"; [[ -f "$test_file" ]] && selected+=("$test_file") ;;
        esac
    done < <({ git diff --name-only "$base"; git ls-files --others --exclude-standard; } | sort -u)
    mapfile -t selected < <(printf '%s\n' "${selected[@]}" | sort -u)
    set -- "${selected[@]}" "$@"
fi
# Fixture trees belong on disk, separately for each run; the job's TMPDIR stays short for sockets.
mkdir -p .tmp
test_root=$(mktemp -d "$PWD/.tmp/tests.XXXXXX")
trap 'rm -rf -- "$test_root"' EXIT
set -- --basetemp "$test_root" "$@"
# a venv set up from another pyproject (a dependency changed since) is set up again before tests run
if [[ "$(sha256sum pyproject.toml)" != "$(cat .venv/.pyproject.sha256 2>/dev/null)" ]]; then
    bin/dev-setup
fi
total_mb=$(awk '/^MemTotal/{print int($2/1024)}' /proc/meminfo)
if [[ -r /sys/fs/cgroup/memory.stat ]]; then
    free_mb=$(( total_mb - $(awk '/^anon /{print int($2/1048576)}' /sys/fs/cgroup/memory.stat) ))
else
    free_mb=$(awk '/^MemAvailable/{print int($2/1024)}' /proc/meminfo)
fi
# Each test process may use at most 4 GB: a runaway test fails with MemoryError instead of exhausting the host.
ulimit -v 4194304
# The width is the admitted JOBS (Terminal admission sets it), never the host's CPUs: no JOBS refuses.
[[ "${JOBS:-}" =~ ^[1-9][0-9]*$ ]] || { echo "bin/test: JOBS='${JOBS:-}' is not an admitted width; run under Terminal admission" >&2; exit 2; }
workers=$(( (free_mb - 4096) / 4096 ))
(( workers > JOBS )) && workers=$JOBS; [[ -n "${UNBAKE_CORES:-}" ]] && (( workers > UNBAKE_CORES )) && workers=$UNBAKE_CORES; (( workers < 1 )) && workers=1
# The workers come out of the one host core budget (the same slots unbake itself divides), at most the memory allows.
# A host without an abucache runtime file has no slot budget (abucache.slots would run one worker): under a Dos
# admission the job's own width is its budget.
slots=(.venv/bin/python -m abucache.slots --work "$workers" --)
if ! .venv/bin/python -c 'from abucache import runtime; runtime.load()' 2>/dev/null; then
    slots=(env)
    set -- "$workers" "$@"
else
    set -- '{j}' "$@"
fi
# Each worker imports every test module: they are rewritten and compiled once first, in parallel over the same cores,
# so the workers start from the bytecode cache instead of each compiling the whole suite again. One core runs in this
# process, without workers to start.
# shellcheck disable=SC2016
"${slots[@]}" bash -c '
    width=$0
    if (( width > 1 )); then
        find tests -name "test_*.py" | sort | xargs -P "$width" -n 8 .venv/bin/python -m pytest -q \
            -p no:cacheprovider -p no:xdist --collect-only > /dev/null 2>&1 || true
    else
        width=0
    fi
    exec .venv/bin/python -m pytest -q -n "$width" "$@"
' "$@"
