#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."
[[ -x .venv/bin/python ]] || { echo "run bin/dev-setup first" >&2; exit 1; }
export PYTHONPATH=src
lock="${XDG_RUNTIME_DIR:-${TMPDIR:?TMPDIR or XDG_RUNTIME_DIR names the test lock directory}}/abu-tests.lock"
if [[ -z "${ABU_TESTS_LOCKED:-}" ]]; then mkdir -p "$(dirname "$lock")"; ABU_TESTS_LOCKED=1 exec flock "$lock" "$PWD/bin/$(basename "$0")" "$@"; fi
# a venv installed from another pyproject (a dependency pin bumped since) is installed again before tests run
if [[ "$(sha256sum pyproject.toml)" != "$(cat .venv/.pyproject.sha256 2>/dev/null)" ]]; then
    .venv/bin/pip install -q -e '.[dev]' && sha256sum pyproject.toml > .venv/.pyproject.sha256
fi
total_mb=$(awk '/^MemTotal/{print int($2/1024)}' /proc/meminfo)
if [[ -r /sys/fs/cgroup/memory.stat ]]; then
    free_mb=$(( total_mb - $(awk '/^anon /{print int($2/1048576)}' /sys/fs/cgroup/memory.stat) ))
else
    free_mb=$(awk '/^MemAvailable/{print int($2/1024)}' /proc/meminfo)
fi
# Each test process may use at most 4 GB: a runaway test fails with MemoryError instead of exhausting the host.
ulimit -v 4194304
workers=$(( (free_mb - 4096) / 4096 )); cores=$(nproc)
(( workers > cores )) && workers=$cores; [[ -n "${UNBAKE_CORES:-}" ]] && (( workers > UNBAKE_CORES )) && workers=$UNBAKE_CORES; (( workers < 1 )) && workers=1
[[ -n "${JOBS:-}" ]] && (( workers > JOBS )) && workers=$JOBS  # a Dos admission's width: the cores it was given
# The workers come out of the one host core budget (the same slots unbake itself divides), at most the memory allows.
# A host without an abucache runtime file has no slot budget (abucache.slots would run one worker): under a Dos
# admission the job's own width is its budget.
slots=(.venv/bin/python -m abucache.slots --work "$workers" --)
if [[ -n "${JOBS:-}" ]] && ! .venv/bin/python -c 'from abucache import runtime; runtime.load()' 2>/dev/null; then
    slots=(env)
    set -- "$workers" "$@"
else
    set -- '{j}' "$@"
fi
# Each worker imports every test module: they are rewritten and compiled once first, in parallel over the same cores,
# so the workers start from the bytecode cache instead of each compiling the whole suite again. One core runs in this
# process, without workers to start.
# shellcheck disable=SC2016
exec "${slots[@]}" bash -c '
    width=$0
    if (( width > 1 )); then
        find tests -name "test_*.py" | sort | xargs -P "$width" -n 8 .venv/bin/python -m pytest -q \
            -p no:cacheprovider -p no:xdist --collect-only > /dev/null 2>&1 || true
    else
        width=0
    fi
    exec .venv/bin/python -m pytest -q -n "$width" "$@"
' "$@"
